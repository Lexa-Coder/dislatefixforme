diff --git a/plugins/dislate/src/patches/AutoTranslate.ts b/plugins/dislate/src/patches/AutoTranslate.ts
new file mode 100644
index 0000000..ad0feb1
--- /dev/null
+++ b/plugins/dislate/src/patches/AutoTranslate.ts
@@ -0,0 +1,188 @@
+import { findByStoreName } from "@vendetta/metro"
+import { FluxDispatcher } from "@vendetta/metro/common"
+import { logger } from "@vendetta"
+import { settings } from ".."
+import { isTranslated, getTranslation, isSameLang, markSameLang, isReverted, getOriginal, clearOriginal } from "../cache"
+import { translateContent, showTranslation, sameLanguage } from "../utils"
+
+const UserStore = findByStoreName("UserStore")
+const SelectedChannelStore = findByStoreName("SelectedChannelStore")
+const MessageStore = findByStoreName("MessageStore")
+
+// How many of the latest messages to translate when a channel is opened / history loads
+const HISTORY_LIMIT = 50
+
+// Letters of common scripts (Latin, Greek, Cyrillic, Hebrew, Arabic, Indic, Thai, CJK, Hangul).
+// Plain ranges instead of \p{...} so it works on every Hermes version.
+const letterRegex = /[A-Za-zÀ-ɏͰ-ϿЀ-ӿ֐-׿؀-ۿऀ-෿฀-๿぀-ヿ㐀-鿿가-힯]/
+
+// Text that has nothing to translate: links, emojis, mentions, numbers, punctuation
+const nothingToTranslate = (s: string) =>
+    !letterRegex.test(
+        s
+            .replace(/https?:\/\/\S+/g, "")
+            .replace(/<(a?):\w+:\d+>|<@!?\d+>|<@&\d+>|<#\d+>|:\w+:/g, "")
+    )
+
+const currentChannel = () => SelectedChannelStore.getChannelId()
+const myId = () => UserStore.getCurrentUser()?.id
+
+// Two independent switches: messages of other people / your own messages
+const anyAuto = () => !!(settings.auto_translate || settings.auto_translate_own)
+const wantsAuthor = (authorId?: string) =>
+    authorId && authorId === myId() ? !!settings.auto_translate_own : !!settings.auto_translate
+
+type Item = { id: string, channel_id: string, content: string, author_id?: string }
+
+// ---------- request queue (sequential, so Google does not rate-limit us) ----------
+const queue: Item[] = []
+const queued = new Set<string>()
+let running = false
+const sleep = (ms: number) => new Promise(r => setTimeout(r, ms))
+
+async function runQueue() {
+    if (running) return
+    running = true
+    try {
+        while (queue.length) {
+            const msg = queue.shift()!
+            queued.delete(msg.id)
+            // Channel was left - skip, it will be queued again when reopened
+            if (!wantsAuthor(msg.author_id) || msg.channel_id !== currentChannel()) continue
+            if (isTranslated(msg.id) || isReverted(msg.id)) continue
+            try {
+                // Google reports the detected language
+                const { text, source_lang } = await translateContent(msg.content, true)
+                if (sameLanguage(source_lang, settings.target_lang)
+                    || !text || text.toLowerCase() === msg.content.trim().toLowerCase()) {
+                    markSameLang(msg.id, msg.content)
+                    continue
+                }
+                let shown = text
+                if (settings.translator === 0) {
+                    try { shown = (await translateContent(msg.content)).text || text } catch (_) { }
+                }
+                if (!isReverted(msg.id)) showTranslation(msg.id, msg.channel_id, msg.content, shown)
+            } catch (e) {
+                logger.error("[Dislate] Auto translate failed:", e)
+                await sleep(1500)
+            }
+            await sleep(200)
+        }
+    } finally {
+        running = false
+    }
+}
+
+// ---------- deciding what to do with a message ----------
+const pendingApply: Item[] = []
+let applyScheduled = false
+
+// Re-apply known translations outside of the current Flux dispatch
+function flushApply() {
+    applyScheduled = false
+    const items = pendingApply.splice(0)
+    for (const m of items) {
+        const t = getTranslation(m.id)
+        if (t && !isReverted(m.id)) showTranslation(m.id, m.channel_id, t.original, t.text)
+    }
+}
+
+function consider(raw: any, channelId: string, priority = false) {
+    if (!raw?.id || typeof raw.content !== "string" || !raw.content) return
+    const authorId = raw.author?.id ?? MessageStore.getMessage(raw.channel_id ?? channelId, raw.id)?.author?.id
+    if (!wantsAuthor(authorId)) return
+    if (isReverted(raw.id)) return
+
+    // Content currently shown is already our translation
+    if (isTranslated(raw.id) && getOriginal(raw.id) !== raw.content) return
+
+    const content = raw.content
+    if (nothingToTranslate(content) || isSameLang(raw.id, content)) return
+
+    const item: Item = { id: raw.id, channel_id: raw.channel_id ?? channelId, content, author_id: authorId }
+
+    // Already translated before -> just show it again, no request
+    const t = getTranslation(raw.id)
+    if (t && t.original === content && t.lang === settings.target_lang) {
+        pendingApply.push(item)
+        if (!applyScheduled) { applyScheduled = true; setTimeout(flushApply, 0) }
+        return
+    }
+
+    if (queued.has(item.id)) return
+    queued.add(item.id)
+    priority ? queue.unshift(item) : queue.push(item)
+    setTimeout(runQueue, 0)
+}
+
+function messagesOf(channelId: string): any[] {
+    const store = MessageStore.getMessages(channelId)
+    const arr = store?.toArray?.() ?? store?._array ?? []
+    return Array.isArray(arr) ? arr : []
+}
+
+// Translate the latest messages of a channel (newest first)
+export function processChannel(channelId = currentChannel()) {
+    if (!anyAuto() || !channelId) return
+    const list = messagesOf(channelId).slice(-HISTORY_LIMIT).reverse()
+    for (const m of list) consider(m, channelId)
+}
+
+// ---------- Flux handlers ----------
+const handlers: Record<string, (a: any) => void> = {
+    MESSAGE_CREATE({ message, optimistic }) {
+        if (!anyAuto() || optimistic) return
+        if (message?.channel_id !== currentChannel()) return
+        consider(message, message.channel_id, true)
+    },
+
+    // Edits, embed loading etc. replace the content shown -> translate / re-apply
+    MESSAGE_UPDATE({ message, otherPluginBypass }) {
+        if (!anyAuto() || otherPluginBypass) return
+        if (!message?.id || typeof message.content !== "string") return
+        if (message.channel_id && message.channel_id !== currentChannel()) return
+        // Discord replaced our text with the real one
+        if (isTranslated(message.id)) {
+            const t = getTranslation(message.id)
+            if (t && t.original === message.content) {
+                pendingApply.push({ id: message.id, channel_id: message.channel_id, content: message.content })
+                if (!applyScheduled) { applyScheduled = true; setTimeout(flushApply, 0) }
+                return
+            }
+            // The author edited the message -> translate the new text
+            clearOriginal(message.id)
+        }
+        consider(message, message.channel_id, true)
+    },
+
+    // History loaded (opening a channel, scrolling up, reconnect)
+    LOAD_MESSAGES_SUCCESS({ channelId, messages }) {
+        if (!anyAuto() || channelId !== currentChannel() || !Array.isArray(messages)) return
+        for (const m of messages.slice(0, HISTORY_LIMIT)) consider(m, channelId)
+    },
+
+    // Switched channel: translate what is already in memory
+    CHANNEL_SELECT({ channelId }) {
+        if (!anyAuto()) return
+        setTimeout(() => processChannel(channelId ?? currentChannel()), 300)
+    }
+}
+
+const wrapped: Record<string, (a: any) => void> = {}
+for (const [event, fn] of Object.entries(handlers)) {
+    wrapped[event] = (a: any) => {
+        try { fn(a) } catch (e) { logger.error(`[Dislate] ${event} handler error:`, e) }
+    }
+}
+
+export default () => {
+    for (const [event, fn] of Object.entries(wrapped)) FluxDispatcher.subscribe(event, fn)
+    // Plugin (re)loaded with auto translate on -> handle the open channel right away
+    setTimeout(() => processChannel(), 500)
+    return () => {
+        for (const [event, fn] of Object.entries(wrapped)) FluxDispatcher.unsubscribe(event, fn)
+        queue.length = 0
+        queued.clear()
+    }
+}
