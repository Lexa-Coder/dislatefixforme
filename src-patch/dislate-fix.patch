diff --git a/plugins/dislate/src/utils.ts b/plugins/dislate/src/utils.ts
new file mode 100644
index 0000000..cb23511
--- /dev/null
+++ b/plugins/dislate/src/utils.ts
@@ -0,0 +1,68 @@
+import { findByStoreName } from "@vendetta/metro"
+import { FluxDispatcher } from "@vendetta/metro/common"
+import { settings } from "."
+import { DeepL, GTranslate } from "./api"
+import { toGoogleLang } from "./api/GTranslate"
+import { setOriginal, getOriginal, clearOriginal } from "./cache"
+
+const ChannelStore = findByStoreName("ChannelStore")
+const separator = "\n"
+
+// Protect custom emojis, mentions and channel links from being mangled
+const tokenRegex = /<(a?):\w+:\d+>|<@!?\d+>|<@&\d+>|<#\d+>/g
+
+export async function translateContent(content: string, forceGoogle = false) {
+    const placeholders: string[] = []
+    const textToTranslate = content.replace(tokenRegex, (match: string) => {
+        placeholders.push(match)
+        return ` [[${placeholders.length - 1}]] `
+    })
+
+    const result = (!forceGoogle && settings.translator === 0)
+        ? await DeepL.translate(textToTranslate, undefined, settings.target_lang)
+        : await GTranslate.translate(textToTranslate, undefined, settings.target_lang)
+
+    let text = result.text
+    placeholders.forEach((original, index) => {
+        text = text.replace(new RegExp(`\\[\\[\\s*${index}\\s*\\]\\]`, "g"), original)
+    })
+    return { text: text.replace(/ {2,}/g, " ").trim(), source_lang: result.source_lang as string }
+}
+
+const dispatchContent = (id: string, channelId: string, content: string) =>
+    FluxDispatcher.dispatch({
+        type: "MESSAGE_UPDATE",
+        message: {
+            id,
+            channel_id: channelId,
+            guild_id: ChannelStore.getChannel(channelId)?.guild_id,
+            content
+        },
+        log_edit: false,
+        otherPluginBypass: true
+    })
+
+export function showTranslation(id: string, channelId: string, originalContent: string, translated: string) {
+    const tag = ` \`[${settings.target_lang?.toLowerCase()}]\``
+    const content = settings.immersive_enabled
+        ? `${originalContent}${separator}${translated}${tag}`
+        : `${translated}${tag}`
+    setOriginal(id, originalContent)
+    dispatchContent(id, channelId, content)
+}
+
+export function revertTranslation(id: string, channelId: string) {
+    const original = getOriginal(id)
+    if (original === undefined) return
+    clearOriginal(id)
+    dispatchContent(id, channelId, original)
+}
+
+// "ru" == "RU" == "ru-RU" ; "zh-CN" vs "zh-TW" are treated as different
+export const sameLanguage = (a?: string, b?: string) => {
+    if (!a || !b) return false
+    const ga = toGoogleLang(a).toLowerCase(), gb = toGoogleLang(b).toLowerCase()
+    if (ga === gb) return true
+    if (ga.startsWith("zh") || gb.startsWith("zh")) return false
+    return ga.split("-")[0] === gb.split("-")[0]
+}
