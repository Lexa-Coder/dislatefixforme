+// Shared store of original message contents, so a translated message
+// (manual or automatic) can be reverted from the long-press menu.
+const originals = new Map<string, string>()
+
+export const getOriginal = (id: string) => originals.get(id)
+export const isTranslated = (id: string) => originals.has(id)
+export const setOriginal = (id: string, content: string) => {
+    originals.set(id, content)
+    // keep memory bounded
+    if (originals.size > 500) originals.delete(originals.keys().next().value)
+}
+export const clearOriginal = (id: string) => originals.delete(id)
