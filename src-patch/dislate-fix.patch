+// Shared translation state used by manual and automatic translation.
+
+const LIMIT = 3000
+const trim = (m: Map<string, any> | Set<string>) => {
+    while (m.size > LIMIT) {
+        const first = m.keys().next().value
+        m.delete(first)
+    }
+}
+
+// Messages that are currently DISPLAYED translated: id -> original content
+const originals = new Map<string, string>()
+// Every translation we have made, so it can be re-applied without a new request
+// when Discord re-renders / reloads the message: id -> { original, text, lang }
+const translations = new Map<string, { original: string, text: string, lang: string }>()
+// Messages already in the target language: id -> content (no need to ask again)
+const sameLang = new Map<string, string>()
+// Messages the user manually reverted: auto translate must leave them alone
+const reverted = new Set<string>()
+
+export const getOriginal = (id: string) => originals.get(id)
+export const isTranslated = (id: string) => originals.has(id)
+export const setOriginal = (id: string, content: string) => { originals.set(id, content); trim(originals) }
+export const clearOriginal = (id: string) => originals.delete(id)
+
+export const getTranslation = (id: string) => translations.get(id)
+export const saveTranslation = (id: string, original: string, text: string, lang: string) => {
+    translations.set(id, { original, text, lang }); trim(translations)
+}
+
+export const isSameLang = (id: string, content: string) => sameLang.get(id) === content
+export const markSameLang = (id: string, content: string) => { sameLang.set(id, content); trim(sameLang) }
+
+export const isReverted = (id: string) => reverted.has(id)
+export const markReverted = (id: string) => { reverted.add(id); trim(reverted) }
+export const unmarkReverted = (id: string) => reverted.delete(id)
