diff --git a/plugins/dislate/src/patches/AutoTranslate.ts b/plugins/dislate/src/patches/AutoTranslate.ts
new file mode 100644
index 0000000..c8b6328
--- /dev/null
+++ b/plugins/dislate/src/patches/AutoTranslate.ts
@@ -0,0 +1,72 @@
+import { findByStoreName } from "@vendetta/metro"
+import { FluxDispatcher } from "@vendetta/metro/common"
+import { logger } from "@vendetta"
+import { settings } from ".."
+import { isTranslated } from "../cache"
+import { translateContent, showTranslation, sameLanguage } from "../utils"
+
+const UserStore = findByStoreName("UserStore")
+const SelectedChannelStore = findByStoreName("SelectedChannelStore")
+
+// Letters of common scripts (Latin, Greek, Cyrillic, Hebrew, Arabic, Indic, Thai, CJK, Hangul).
+// Plain ranges instead of \p{...} so it works on every Hermes version.
+const letterRegex = /[A-Za-zÀ-ɏͰ-ϿЀ-ӿ֐-׿؀-ۿऀ-෿฀-๿぀-ヿ㐀-鿿가-힯]/
+
+// Text that has nothing to translate: links, emojis, mentions, numbers, punctuation
+const nothingToTranslate = (s: string) =>
+    !letterRegex.test(
+        s
+            .replace(/https?:\/\/\S+/g, "")
+            .replace(/<(a?):\w+:\d+>|<@!?\d+>|<@&\d+>|<#\d+>|:\w+:/g, "")
+    )
+
+// Sequential queue so we don't hammer the translator (avoids 429 errors)
+const queue: any[] = []
+let running = false
+const sleep = (ms: number) => new Promise(r => setTimeout(r, ms))
+
+async function runQueue() {
+    if (running) return
+    running = true
+    while (queue.length) {
+        const msg = queue.shift()
+        try {
+            if (!settings.auto_translate || isTranslated(msg.id)) continue
+            // Google is used here because it reports the detected language
+            const { text, source_lang } = await translateContent(msg.content, true)
+            if (sameLanguage(source_lang, settings.target_lang)) continue
+            if (!text || text.toLowerCase() === msg.content.trim().toLowerCase()) continue
+
+            // Use the configured translator (e.g. DeepL) for the shown text, if not Google
+            let shown = text
+            if (settings.translator === 0) {
+                try { shown = (await translateContent(msg.content)).text || text } catch { }
+            }
+            showTranslation(msg.id, msg.channel_id, msg.content, shown)
+        } catch (e) {
+            logger.error("[Dislate] Auto translate failed:", e)
+        }
+        await sleep(250)
+    }
+    running = false
+}
+
+function onMessageCreate({ message, optimistic }: any) {
+    try {
+        if (!settings.auto_translate || optimistic || !message?.content) return
+        if (message.author?.id && message.author.id === UserStore.getCurrentUser()?.id) return
+        // Only the channel that is currently open, to keep requests low
+        if (message.channel_id !== SelectedChannelStore.getChannelId()) return
+        if (nothingToTranslate(message.content)) return
+        if (queue.length > 20) queue.shift()
+        queue.push({ id: message.id, channel_id: message.channel_id, content: message.content })
+        runQueue()
+    } catch (e) {
+        logger.error("[Dislate] Auto translate handler error:", e)
+    }
+}
+
+export default () => {
+    FluxDispatcher.subscribe("MESSAGE_CREATE", onMessageCreate)
+    return () => FluxDispatcher.unsubscribe("MESSAGE_CREATE", onMessageCreate)
+}
